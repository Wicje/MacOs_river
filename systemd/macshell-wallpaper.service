[Unit]
Description=macOS Tahoe desktop wallpaper (layer-shell background)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/river/wallpaper.py
WorkingDirectory=%h
Environment=PYTHONPATH=%h/.config
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
