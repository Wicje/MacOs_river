[Unit]
Description=macOS Tahoe shell (menu bar, dock, control centre, widgets)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m macshell.shell
WorkingDirectory=%h/.config
Environment=PYTHONPATH=%h/.config
Restart=on-failure
RestartSec=3
Nice=-5

[Install]
WantedBy=default.target
