#!/usr/bin/env python3
"""mstatus -- put your own badge into the menu bar, the macOS way.

On macOS every program can keep a small badge in the menu bar (an
NSStatusItem): Filecoin synchs, Raycast glows, Claude turns orange while
it thinks.  macshell turns the same idea over to the programs of this
machine: one tiny json file per badge in the session folder, written
through this helper, read by the menu bar every second.

    mstatus set claude --glyph claude --color orange \\
        --title "Claude is thinking" --run "foot -e claude"
    mstatus ping claude        # renew the badge, keep what it says
    mstatus del claude         # take the badge away
    mstatus list               # what the bar is showing right now

Every `set` starts the expiry fresh (default one hour); a program that
keeps running calls `ping` now and then, one that stops fades out of
the bar on its own -- no uninstalling, nothing left behind.

A badge is two fields plus a command:

    --glyph NAME   one of the shell's glyphs (sparkles, claude, moon, ...)
    --icon PATH    a png of the program's own, drawn instead of a glyph
    --color NAME   text | accent | faint | an accent (orange...) | #rrggbb
    --text COUNT   a small count beside the glyph, the way usage does
    --run CMD      executed with sh when the badge is clicked
    --title S      the name, probed by future popovers
    --ttl SEC      seconds until the badge fades unless pinged
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time

DEFAULT_TTL = 3600


def _dir():
    return os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"),
        "macshell", "status")


def _item_path(ref):
    name = ref.strip() or "item"
    return os.path.join(_dir(), name.replace("/", "_") + ".json")


def _load(ref):
    try:
        with open(_item_path(ref)) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def _write(ref, item):
    path = _item_path(ref)
    try:
        os.makedirs(_dir(), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(item, fh)
        os.replace(tmp, path)
    except OSError as err:
        print(f"mstatus: cannot write {path}: {err}", file=sys.stderr)
        return 1
    return 0


def cmd_set(ref, args):
    item = _load(ref) or {}
    fields = {
        "glyph": args.glyph, "icon": args.icon, "color": args.color,
        "text": args.text, "run": args.run, "title": args.title,
    }
    for key, value in fields.items():
        if value is not None:
            item[key] = value
    item["ttl"] = float(args.ttl) if args.ttl is not None \
        else float(item.get("ttl") or DEFAULT_TTL)
    item["updated"] = time.time()
    return _write(ref, item)


def cmd_ping(ref, _args):
    item = _load(ref)
    if item is None:
        print(f"mstatus: no item '{ref}' (set it first)", file=sys.stderr)
        return 1
    item["updated"] = time.time()
    return _write(ref, item)


def cmd_del(refs, _args):
    code = 0
    for ref in refs:
        try:
            os.unlink(_item_path(ref))
        except OSError:
            print(f"mstatus: no item '{ref}'", file=sys.stderr)
            code = 1
    return code


def cmd_list(_dirs, _args):
    import glob as _glob
    items = []
    for path in sorted(_glob.glob(os.path.join(_dir(), "*.json"))):
        try:
            with open(path) as fh:
                item = json.load(fh)
        except (OSError, ValueError):
            continue
        ttl = float(item.get("ttl", DEFAULT_TTL) or DEFAULT_TTL)
        if time.time() - float(item.get("updated", 0)) > ttl:
            continue
        id_ = os.path.basename(path)[:-5]
        bits = [id_]
        if item.get("title"):
            bits.append(str(item["title"]))
        if item.get("text"):
            bits.append(f"[{item['text']}]")
        bits.append(f"({item.get('color') or 'text'}")
        bits.append(f"{item.get('glyph') or item.get('icon') or '?'})")
        items.append("  ".join(bits))
    if items:
        print("\n".join(items))
    else:
        print("(no live items)")
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="mstatus", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p_set = sub.add_parser("set", help="create or update a badge")
    p_set.add_argument("ref", help="the badge id, e.g. claude")
    p_set.add_argument("--glyph", help="one of the shell's glyphs")
    p_set.add_argument("--icon", help="path of a png to draw")
    p_set.add_argument("--color", help="text|accent|faint|orange|#hex")
    p_set.add_argument("--text", help="small count beside the glyph")
    p_set.add_argument("--run", help="command a click executes")
    p_set.add_argument("--title", help="the badge's name")
    p_set.add_argument("--ttl", type=float,
                       help=f"expiry seconds (default {DEFAULT_TTL})")
    p_set.set_defaults(func=cmd_set)

    p_ping = sub.add_parser("ping", help="renew a badge, keeping its values")
    p_ping.add_argument("ref")
    p_ping.set_defaults(func=cmd_ping)

    p_del = sub.add_parser("del", help="remove one or more badges")
    p_del.add_argument("refs", nargs="+")
    p_del.set_defaults(func=cmd_del)

    p_list = sub.add_parser("list", help="what the bar shows right now")
    p_list.set_defaults(func=cmd_list)

    args = parser.parse_args()
    if args.command == "del":
        code = args.func(args.refs, args)
    else:
        code = args.func(getattr(args, "ref", False), args)
    sys.exit(code)


if __name__ == "__main__":
    main()
